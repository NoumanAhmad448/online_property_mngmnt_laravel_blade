SERVER_ALIAS=
APP_NAME=
# never change app_env from local to some else word
APP_ENV=local
APP_KEY=
APP_DEBUG=False
JS_DEBUG=True
APP_URL=localhost:8080

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=${SERVER_ALIAS}
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
